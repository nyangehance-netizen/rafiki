# Copy this file to ".env" and fill in your key. Never share your real key.

# Your Claude API key from https://console.anthropic.com  (starts with sk-ant-)
ANTHROPIC_API_KEY=sk-ant-weka-key-yako-hapa

# Which Claude model answers. Haiku is fastest and cheapest.
# For smarter (but more expensive) answers use: claude-sonnet-5-5
MODEL=claude-haiku-4-5-20251001

# Messages each person can send per day
DAILY_LIMIT=20

# Messages the whole site can answer per day (protects your bill)
GLOBAL_DAILY_LIMIT=1000

# Longest answer, in tokens (about 0.75 words each)
MAX_TOKENS=1500

# Port the server listens on (hosting services set this for you)
PORT=3000
